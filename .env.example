APP_NAME="True Commerce"
APP_URL=http://localhost/mahfuz/crm/public
APP_ENV=local
APP_DEBUG=true
APP_KEY=base64:changethis32characterkeyimmediately!!
JWT_SECRET=change_this_jwt_secret_in_production
